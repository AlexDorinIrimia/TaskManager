# ─────────────────────────────────────────────
# STAGE 1: Build
# Vite builds into /dist (not /build like CRA)
# ─────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./

# If you use yarn, replace with: RUN yarn install
RUN npm install
RUN npm audit fix --force

COPY . .

# Vite's build command — outputs to /app/dist
RUN npm run build

# ─────────────────────────────────────────────
# STAGE 2: Serve
# Copy /dist (Vite) not /build (CRA) into Nginx
# ─────────────────────────────────────────────
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
